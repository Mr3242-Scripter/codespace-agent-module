{
  "name": "codespace-agent-playground",
  "private": true,
  "type": "module",
  "scripts": {
    "agent:start": "bash src/codespace/agent-service.sh start",
    "agent:status": "bash src/codespace/agent-service.sh status",
    "agent:stop": "bash src/codespace/agent-service.sh stop",
    "agent:check-deps": "node scripts/check-agent-deps.mjs",
    "typecheck": "tsc --noEmit",
    "test:agent": "tsx --test src/codespace/agent-utils.test.ts src/codespace/agent-service.test.ts src/codespace/install.test.ts",
    "check:agent": "npm run agent:check-deps && npm run typecheck && npm run test:agent"
  },
  "devDependencies": {
    "@devcontainers/cli": "^0.90.0",
    "@types/node": "^22.20.5",
    "bash-language-server": "^3.3.1",
    "node-pty": "^1.1.0",
    "pyright": "^1.1.408",
    "tsx": "^4.20.3",
    "typescript": "^7.0.2",
    "typescript-language-server": "^6.1.0",
    "vscode-langservers-extracted": "^4.10.0",
    "yaml-language-server": "^2.0.0"
  }
}
